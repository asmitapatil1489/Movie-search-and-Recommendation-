------MultipartBoundary--u3CQf3PnPGOAdb7reSmSmJEgorzflDrpdLLntOIi5O----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-0633ee37-5c65-4d19-93e8-ca32d4733fb5@mhtml.blink

@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: Arial, sans-serif; background: rgb(9, 11, 26); color: white; }

.app { min-height: 100vh; }

.hero { min-height: 520px; padding: 25px 7%; background: radial-gradient(circle at 20% 20%, rgba(115, 60, 255, 0.333), transparent 35%), radial-gradient(circle at 80% 20%, rgba(255, 46, 166, 0.333), transparent 35%), linear-gradient(135deg, rgb(17, 22, 51), rgb(8, 9, 20)); }

nav { display: flex; justify-content: space-between; align-items: center; }

.logo { font-size: 30px; font-weight: bold; }

.logo span { color: rgb(255, 60, 172); }

.nav-text { color: rgb(201, 201, 221); }

.hero-content { max-width: 850px; margin: 100px auto 0px; text-align: center; }

.hero-content h1 { font-size: 55px; line-height: 1.1; margin-bottom: 20px; }

.hero-content h1 span { background: linear-gradient(90deg, rgb(255, 60, 172), rgb(120, 76, 255), rgb(0, 217, 255)) text; color: transparent; }

.hero-content p { color: rgb(200, 200, 216); font-size: 18px; margin-bottom: 30px; }

.search-box { display: flex; max-width: 700px; margin: auto; background: white; padding: 7px; border-radius: 50px; }

.search-box input { flex: 1 1 0%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; padding: 15px 20px; font-size: 16px; border-radius: 50px; }

.search-box button { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px 28px; border-radius: 40px; background: linear-gradient(90deg, rgb(255, 60, 172), rgb(120, 76, 255)); color: white; font-size: 16px; font-weight: bold; cursor: pointer; }

.quick-buttons { margin-top: 25px; }

.quick-buttons button { border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.07); color: white; padding: 10px 18px; margin: 5px; border-radius: 25px; cursor: pointer; }

.quick-buttons button:hover { background: rgb(255, 60, 172); }

.section, .recommend-section { padding: 55px 7%; }

.section-title { margin-bottom: 30px; }

.section-title h2, .recommend-section h2 { font-size: 30px; margin-bottom: 8px; }

.section-title p, .recommend-section > p { color: rgb(170, 170, 189); }

.movie-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 25px; }

.movie-card { background: rgb(21, 24, 43); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 18px; overflow: hidden; cursor: pointer; transition: 0.3s; }

.movie-card:hover { transform: translateY(-8px); box-shadow: rgba(0, 0, 0, 0.533) 0px 15px 35px; border-color: rgba(255, 60, 172, 0.533); }

.poster { width: 100%; height: 280px; object-fit: cover; display: block; }

.movie-info { padding: 15px; }

.movie-info h3 { font-size: 17px; margin-bottom: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.rating { display: inline-block; background: rgb(255, 193, 7); color: rgb(17, 17, 17); font-weight: bold; padding: 5px 9px; border-radius: 8px; font-size: 13px; }

.language { display: inline-block; margin-left: 5px; padding: 5px 8px; background: rgba(120, 76, 255, 0.2); color: rgb(188, 174, 255); border-radius: 8px; font-size: 12px; }

.loading { text-align: center; padding: 50px; color: rgb(187, 187, 187); display: none; }

.error { text-align: center; color: rgb(255, 107, 138); padding: 20px; }

.recommend-section { background: linear-gradient(135deg, rgb(23, 19, 45), rgb(13, 25, 48)); }

.recommend-section h2 { color: rgb(255, 100, 187); }

.modal { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.8); display: none; align-items: center; justify-content: center; padding: 20px; z-index: 1000; }

.modal-content { width: 900px; max-width: 100%; max-height: 90vh; overflow-y: auto; background: rgb(21, 24, 43); border-radius: 22px; position: relative; padding: 25px; }

.close-btn { position: absolute; right: 20px; top: 15px; width: 40px; height: 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; background: rgb(255, 60, 172); color: white; font-size: 28px; cursor: pointer; }

.details { display: flex; gap: 30px; }

.details img { width: 280px; border-radius: 15px; }

.details-text { flex: 1 1 0%; }

.details-text h2 { font-size: 35px; margin-bottom: 15px; }

.details-text p { color: rgb(196, 196, 210); line-height: 1.7; margin: 12px 0px; }

.tag { display: inline-block; background: rgba(120, 76, 255, 0.2); color: rgb(187, 170, 255); padding: 7px 12px; margin: 4px; border-radius: 15px; }

footer { text-align: center; padding: 40px; background: rgb(6, 7, 18); color: rgb(153, 153, 153); }

footer h3 { color: white; margin-bottom: 10px; }

@media (max-width: 700px) {
  .hero { padding: 20px; }
  .nav-text { display: none; }
  .hero-content { margin-top: 70px; }
  .hero-content h1 { font-size: 38px; }
  .search-box { flex-direction: column; background: transparent; gap: 10px; }
  .search-box input { width: 100%; }
  .search-box button { padding: 14px; }
  .section, .recommend-section { padding: 40px 20px; }
  .movie-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
  .poster { height: 240px; }
  .details { flex-direction: column; }
  .details img { width: 100%; max-width: 300px; margin: auto; }
  .details-text h2 { font-size: 27px; }
}
